<!--
  Offline (non-Unity) harness for the notes document layer (Notes П1).

  It compiles the REAL Unity sources (copied verbatim into gen/ by sync.ps1) against the same ~40 lines of
  UnityEngine/Newtonsoft stubs f2-harness uses, so every PASS/FAIL it prints comes from the shipped code
  rather than a paraphrase. NotesDocOps is pure C# with no UnityEngine dependency, so the whole suite runs
  here — no Editor, no scene, no Library import.

  Deliberately a SEPARATE harness from Tools/f2-harness: that one's sync.ps1 is a live instrument of the
  settlement work and must not be edited concurrently. Merging the two (shared stubs, one driver) is a
  cleanup for after feat/settlement-render lands.

  Usage (from this directory):
      powershell -File sync.ps1
      dotnet run -c Release [SEP] selftests    runs every NotesDocOps self-test
  where [SEP] is the two-dash argument separator (XML comments cannot contain it).
  Run it from bash, not PowerShell — PowerShell 5.1 swallows the separator.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>notesharness</AssemblyName>
    <RootNamespace>NotesHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0169;CS0649;CS0162;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="gen/*.cs" />
    <Compile Include="stubs/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
