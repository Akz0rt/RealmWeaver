# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
/installer/Output/

# Crashlytics
crashlytics-build.properties

# Dev tooling / process scratch (not needed for the app)
/.superpowers/
/.claude/
/docs/superpowers/
/.vsconfig

# Tools/f2-harness is a TRACKED offline (non-Unity) test harness for the building-interiors packer — its
# project file is real evidence, not IDE scratch, so it is exempted from the blanket *.csproj rule above.
# Its own generated/build output stays ignored (sync.ps1 regenerates gen/ from the real Assets/ sources).
!/Tools/f2-harness/*.csproj
/Tools/f2-harness/bin/
/Tools/f2-harness/obj/
/Tools/f2-harness/gen/

# Tools/notes-harness — the same arrangement for the notes document layer (Notes П1). Kept separate from
# f2-harness on purpose: that harness's sync.ps1 is edited by the settlement work, and two agents must not
# share one instrument.
!/Tools/notes-harness/*.csproj
/Tools/notes-harness/bin/
/Tools/notes-harness/obj/
/Tools/notes-harness/gen/

# Tools/player-harness — the same arrangement for the player-prep rules data layer (player-prep И1).
# Separate sync.ps1/gen from the other two harnesses for the same reason: one instrument per arc.
!/Tools/player-harness/*.csproj
/Tools/player-harness/bin/
/Tools/player-harness/obj/
/Tools/player-harness/gen/
